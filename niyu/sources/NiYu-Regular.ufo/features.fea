feature liga {
    sub f f by f_f;
    sub f i by f_i;
    sub f l by f_l;
} liga;


feature zero {
    sub zero by zero.zero;
} zero;


feature onum {
    sub zero by zero.onum;
    sub one by one.onum;
    sub two by two.onum;
    sub three by three.onum;
    sub four by four.onum;
    sub five by five.onum;
    sub six by six.onum;
    sub seven by seven.onum;
    sub eight by eight.onum;
    sub nine by nine.onum;
} onum;


feature lnum {
    sub zero.onum by zero;
    sub one.onum by one;
    sub two.onum by two;
    sub three.onum by three;
    sub four.onum by four;
    sub five.onum by five;
    sub six.onum by six;
    sub seven.onum by seven;
    sub eight.onum by eight;
    sub nine.onum by nine;
} lnum;


